# Salin menjadi backend/.env lalu sesuaikan.
DATABASE_URL=postgres://zero:zero@localhost:5432/zero_outlet_pos
BIND_ADDR=0.0.0.0:3000
# Sesi login berakhir otomatis setelah tidak aktif selama N menit (KF-01)
SESSION_IDLE_MINUTES=30
# Folder hasil build frontend yang disajikan oleh backend
FRONTEND_DIST=../frontend/dist
# Akun admin pertama dibuat otomatis jika belum ada admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_NAMA=Pemilik Toko
# Set true bila diakses lewat HTTPS (mode cloud)
COOKIE_SECURE=false
RUST_LOG=info,zero_outlet_pos=debug
