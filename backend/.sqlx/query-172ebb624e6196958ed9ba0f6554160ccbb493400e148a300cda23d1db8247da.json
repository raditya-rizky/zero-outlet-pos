{
  "db_name": "PostgreSQL",
  "query": "SELECT v.id_varian, v.id_produk, v.ukuran, v.warna, v.stok\n           FROM varian v JOIN produk p ON p.id_produk = v.id_produk\n           WHERE v.id_produk = ANY($1) AND v.aktif AND p.aktif\n           ORDER BY array_position(ARRAY['XS','S','M','L','XL','XXL','XXXL'], upper(v.ukuran)) NULLS LAST, v.ukuran, v.warna",
