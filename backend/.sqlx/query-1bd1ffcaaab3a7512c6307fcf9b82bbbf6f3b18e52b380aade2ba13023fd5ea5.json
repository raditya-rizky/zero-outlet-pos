  "query": "SELECT s.id_sesi, p.nama AS nama_kasir, s.waktu_buka, s.waktu_tutup, s.selisih, s.alasan_selisih\n           FROM sesi_kasir s JOIN pengguna p ON p.id_pengguna = s.id_pengguna\n           WHERE s.waktu_tutup IS NULL ORDER BY s.waktu_buka",
