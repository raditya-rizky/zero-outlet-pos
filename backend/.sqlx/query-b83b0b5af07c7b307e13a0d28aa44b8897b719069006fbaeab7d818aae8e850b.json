  "query": "SELECT p.id_pengguna, p.nama, p.username, p.peran\n                   FROM sesi_login s JOIN pengguna p ON p.id_pengguna = s.id_pengguna\n                   WHERE s.token_hash = $1\n                     AND p.aktif\n                     AND s.terakhir_aktif > now() - make_interval(mins => $2)",
