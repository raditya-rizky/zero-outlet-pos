  "query": "SELECT id_varian, id_produk, sku, ukuran, warna, stok, stok_minimum, aktif\n           FROM varian\n           WHERE id_produk = ANY($1) AND ($2 OR aktif)\n           ORDER BY id_produk,\n                    array_position(ARRAY['XS','S','M','L','XL','XXL','XXXL'], upper(ukuran)) NULLS LAST,\n                    ukuran, warna",
