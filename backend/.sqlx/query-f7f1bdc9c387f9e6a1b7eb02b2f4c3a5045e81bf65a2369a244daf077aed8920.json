{
  "db_name": "PostgreSQL",
  "query": "SELECT v.id_varian, v.stok, v.sku, p.nama || ' ' || v.ukuran || '/' || v.warna AS \"nama_barang!\"\n           FROM varian v JOIN produk p ON p.id_produk = v.id_produk\n           WHERE v.id_varian = ANY($1)\n           ORDER BY v.id_varian\n           FOR UPDATE OF v",
